<Window x:Class="SP_Addin.ReinforcementCoeff.ReinforcementCoeffView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:SP_Addin.ReinforcementCoeff"
        xmlns:styles="clr-namespace:SP_Addin.ReinforcementCoeff.Styles"
        mc:Ignorable="d"
        Title="Средний расход арматуры"
        Width="{x:Static local:ReinforcementCoeffReportLayout.DefaultWindowWidth}"
        Height="{x:Static local:ReinforcementCoeffReportLayout.DefaultWindowHeight}"
        MinWidth="{x:Static local:ReinforcementCoeffReportLayout.MinWindowWidth}"
        MinHeight="{x:Static local:ReinforcementCoeffReportLayout.MinWindowHeight}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        FontFamily="{DynamicResource SpFont.Ui}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SP.ReinforcementCoeff;component/Styles/SpSettingsTheme.xaml"/>
                <ResourceDictionary Source="ReinforcementCoeffReportResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource IdsModernScrollBarStyle}"/>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="6,2,6,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="RoundedButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFFCFCFC"/>
                <Setter Property="BorderBrush" Value="#FFC3C3C3"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource SpFont.Ui}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF0DA9CA"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#FF0DA9CA"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF128085"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#FF128085"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.6"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <DataTemplate x:Key="ReportRowItemTemplate">
                <Border BorderBrush="#FFE1E7EB" BorderThickness="0,0,0,1" Padding="8,6" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                    <Grid MinWidth="{x:Static local:ReinforcementCoeffReportLayout.TableMinWidth}"
                          HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColKitWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColKitMinWidth}"/>
                            <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColGroupingWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColGroupingMinWidth}"/>
                            <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColVolumeWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColVolumeMinWidth}"/>
                            <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColRebarMassWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColRebarMassMinWidth}"/>
                            <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColCoefficientWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColCoefficientMinWidth}"/>
                            <ColumnDefinition Width="*" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColStatusMinWidth}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource ColumnDividerBorderStyle}">
                            <TextBox Text="{Binding KitName, Mode=OneWay}" Style="{StaticResource CopyableCellTextBoxStyle}"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ColumnDividerBorderStyle}">
                            <TextBox Text="{Binding GroupingDisplay, Mode=OneWay}" Style="{StaticResource CopyableCellTextBoxStyle}"/>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ColumnDividerBorderStyle}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ConcreteVolumeDisplay, Mode=OneWay}"
                                         Style="{StaticResource CopyableCellTextBoxStyle}"/>
                                <Button Grid.Column="1"
                                        Content="➤"
                                        Width="18"
                                        MinWidth="0"
                                        Height="18"
                                        Margin="2,0,0,0"
                                        Padding="0"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        ToolTip="Показать состав объёма бетона группы"
                                        Style="{StaticResource SpSettingsSecondaryButton}"
                                        Visibility="{Binding HasConcreteElementIds, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.SelectConcreteElementsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource ColumnDividerBorderStyle}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding RebarMassDisplay, Mode=OneWay}"
                                         Style="{StaticResource CopyableCellTextBoxStyle}"/>
                                <Button Grid.Column="1"
                                        Content="➤"
                                        Width="18"
                                        MinWidth="0"
                                        Height="18"
                                        Margin="2,0,0,0"
                                        Padding="0"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        ToolTip="Показать состав массы арматуры по видам"
                                        Style="{StaticResource SpSettingsSecondaryButton}"
                                        Visibility="{Binding HasRebarElementIds, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.SelectRebarElementsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource ColumnDividerBorderStyle}">
                            <TextBox Text="{Binding CoefficientDisplay, Mode=OneWay}" Style="{StaticResource CopyableCellTextBoxStyle}"/>
                        </Border>
                        <Border Grid.Column="5" Padding="4,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <TextBox Text="{Binding Status, Mode=OneWay}" Style="{StaticResource CopyableWrapCellTextBoxStyle}"/>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource SpSettingsChromeOuter}">
        <Border x:Name="ChromeRoot" Style="{StaticResource SpSettingsChrome}" SizeChanged="ChromeRoot_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*" MinHeight="{x:Static local:ReinforcementCoeffReportLayout.ReportPanelMinHeight}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SpSettingsHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="{StaticResource SpSpace.HeaderInset}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Средний расход арматуры" Style="{StaticResource SpSettingsHeaderTitle}"
                               FontFamily="Arial" FontSize="15.5" FontWeight="SemiBold"/>
                    <styles:SpSettingsCaptionButtons Grid.Column="1" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="HeaderCloseButton"
                            Style="{StaticResource SpSettingsHeaderClose}"
                            VerticalAlignment="Center" Click="CloseButton_Click"
                            AutomationProperties.Name="Закрыть"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="14,8,14,0"
                    MinWidth="{x:Static local:ReinforcementCoeffReportLayout.SettingsPanelMinWidth}"
                    Style="{StaticResource SpSettingsToolBar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="200"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Комплект:">
                        <Label.ToolTip>
                            <ToolTip MaxWidth="360">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Значение ADSK_Комплект у бетонных элементов и RNF.Раздел у арматуры. Если поле пустое — обрабатываются все найденные комплекты."/>
                            </ToolTip>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Style="{StaticResource SpSettingsTextBox}"
                             Text="{Binding KitName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,6,0,4"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <RadioButton Style="{StaticResource SpSettingsRadioButton}"
                                     GroupName="ReinforcementCoeffGroupingMode"
                                     Content="По значению параметра группировки"
                                     IsChecked="{Binding IsGroupingValueModeSelected, Mode=TwoWay}">
                            <RadioButton.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Расчёт по уникальным значениям параметра группировки (бетон и узлы — один параметр, по умолчанию SP_ВРС_Группирование). Поле «Комплект» необязательно — если пусто, обрабатываются все найденные комплекты."/>
                                </ToolTip>
                            </RadioButton.ToolTip>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SpSettingsRadioButton}"
                                     GroupName="ReinforcementCoeffGroupingMode"
                                     Content="Автоматически по отметке"
                                     Margin="24,0,0,0"
                                     IsChecked="{Binding IsElevationModeSelected, Mode=TwoWay}">
                            <RadioButton.ToolTip>
                                <ToolTip MaxWidth="360">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Расчёт по парам «отметка + комплект». Сначала определяется отметка (ADSK_Группирование у бетона, RNF.Марка конструкции у узлов), затем комплект (ADSK_Комплект / RNF.Раздел). Поле «Комплект» необязательно — если пусто, обрабатываются все найденные комплекты."/>
                                </ToolTip>
                            </RadioButton.ToolTip>
                        </RadioButton>
                    </StackPanel>

                    <Label Grid.Row="2" Grid.Column="0" Content="Параметр для группирования:"
                           IsEnabled="{Binding IsGroupingValueMode}">
                        <Label.ToolTip>
                            <ToolTip MaxWidth="360">
                                <TextBlock TextWrapping="Wrap"
                                           Text="Имя параметра группировки для бетона и узлов (по умолчанию SP_ВРС_Группирование). Сопоставление — по точному совпадению значения этого параметра."/>
                            </ToolTip>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource SpSettingsTextBox}"
                             Text="{Binding GroupingParameterName, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsGroupingValueMode}"
                             Margin="0,8,0,2"/>

                    <DockPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                               Margin="0,10,0,0"
                               LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource SpSettingsSecondaryButton}"
                                Content="+"
                                Width="28"
                                Height="26"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Command="{Binding AddFilterConditionCommand}"
                                ToolTip="Добавить условие фильтрации по параметру"/>
                        <TextBlock Text="Доп. условия фильтрации"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SpFont.Ui}"
                                   FontSize="14">
                            <TextBlock.ToolTip>
                                <ToolTip MaxWidth="380">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Дополнительные условия по параметрам (логика И). Для арматуры всегда требуется заполненный RNF.Марка конструкции. Условия с пустым именем параметра игнорируются."/>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </DockPanel>

                    <ScrollViewer Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                  Margin="0,6,0,2"
                                  MaxHeight="132"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AdditionalFilters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ReinforcementCoeffFilterConditionItem}">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource SpSettingsTextBox}"
                                                 Margin="0,0,6,0"
                                                 Text="{Binding ParameterName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Имя параметра элемента"/>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource SpSettingsComboBox}"
                                                  Height="26"
                                                  Margin="0,0,6,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding DataContext.FilterOperatorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Operator, Mode=TwoWay}"
                                                  ToolTip="Способ сравнения значения параметра"/>
                                        <TextBox Grid.Column="2"
                                                 Style="{StaticResource SpSettingsTextBox}"
                                                 Margin="0,0,6,0"
                                                 IsEnabled="{Binding IsValueEnabled}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Ожидаемое значение (для «Равен», «Не равен», «Содержит»)"/>
                                        <ComboBox Grid.Column="3"
                                                  Style="{StaticResource SpSettingsComboBox}"
                                                  Height="26"
                                                  Margin="0,0,6,0"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding DataContext.FilterTargetOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Target, Mode=TwoWay}"
                                                  ToolTip="К каким элементам применяется условие"/>
                                        <Button Grid.Column="4"
                                                Style="{StaticResource SpSettingsSecondaryButton}"
                                                Content="−"
                                                Width="28"
                                                Height="26"
                                                Command="{Binding DataContext.RemoveFilterConditionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Удалить условие"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="2"
                          Style="{StaticResource IdsHorizontalSplitterStyle}"/>

            <Border Grid.Row="3" Margin="8,0,8,0" Style="{StaticResource SpSettingsToolBar}" Padding="1">
                <Grid Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  x:Name="ReportHeaderScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  Background="#FFE7EEF2"
                                  BorderBrush="#FFC9D4DB"
                                  BorderThickness="0,0,0,1">
                        <Grid x:Name="ReportHeaderGrid"
                              Margin="8,6"
                              MinWidth="{x:Static local:ReinforcementCoeffReportLayout.TableMinWidth}"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColKitWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColKitMinWidth}"/>
                                <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColGroupingWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColGroupingMinWidth}"/>
                                <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColVolumeWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColVolumeMinWidth}"/>
                                <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColRebarMassWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColRebarMassMinWidth}"/>
                                <ColumnDefinition Width="{x:Static local:ReinforcementCoeffReportLayout.ColCoefficientWidth}" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColCoefficientMinWidth}"/>
                                <ColumnDefinition Width="*" MinWidth="{x:Static local:ReinforcementCoeffReportLayout.ColStatusMinWidth}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource ColumnDividerBorderStyle}">
                                <TextBlock Text="Комплект" Style="{StaticResource HeaderTextStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="ADSK_Комплект у бетона и RNF.Раздел у арматуры узлов."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource ColumnDividerBorderStyle}">
                                <TextBlock Text="Группирование" Style="{StaticResource HeaderTextStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Отметка (+33.200), значение SP_ВРС_Группирование или исходный текст ADSK_Группирование / RNF.Марка конструкции."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource ColumnDividerBorderStyle}">
                                <TextBlock Text="Объём" Style="{StaticResource HeaderTextStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="340">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Суммарный объём материалов с «Мтрл.КодМатериала», начинающимся с 20 (GetMaterialVolume) по элементам группы."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource ColumnDividerBorderStyle}">
                                <TextBlock Text="Масса арм." Style="{StaticResource HeaderTextStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Суммарная масса арматуры группы по формуле RNF."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource ColumnDividerBorderStyle}">
                                <TextBlock Text="Ср. расход" Style="{StaticResource HeaderTextStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Средний расход арматуры: масса арматуры / объём бетона (SP_Средний расход арматуры)."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                            <Border Grid.Column="5" Padding="4,0">
                                <TextBlock Text="Статус" Style="{StaticResource HeaderTextStyle}">
                                    <TextBlock.ToolTip>
                                        <ToolTip MaxWidth="320">
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="Результат расчёта для группы: OK или описание ошибки."/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <ListView Grid.Row="1"
                              x:Name="ReportRowsListView"
                              Style="{StaticResource SpSettingsListView}"
                              ItemsSource="{Binding Groups}"
                              ItemTemplate="{StaticResource ReportRowItemTemplate}"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource ReportListViewItemStyle}"/>
                        </ListView.ItemContainerStyle>
                        <ListView.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource IdsModernScrollBarStyle}"/>
                        </ListView.Resources>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="4" Margin="14,0,14,0" Style="{StaticResource SpSettingsFooter}" Padding="8,6">
                <TextBlock Style="{StaticResource SpSettingsBodyText}" FontWeight="SemiBold"
                           Text="{Binding SummaryText}"/>
            </Border>

            <Grid Grid.Row="5" Margin="14,0,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Style="{StaticResource SpSettingsSecondaryButton}"
                        Content="Записать значения"
                        Width="150"
                        Height="28"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Command="{Binding WriteValuesCommand}"/>

                <Button Grid.Column="2"
                        Style="{StaticResource SpSettingsSecondaryButton}"
                        Content="Рассчитать"
                        Width="120"
                        Height="28"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Command="{Binding RunCommand}"/>

                <Button Grid.Column="3"
                        Style="{StaticResource SpSettingsSecondaryButton}"
                        Content="Закрыть"
                        Width="90"
                        Height="28"
                        VerticalAlignment="Center"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
        </Border>
    </Border>
</Window>
